---
import BaseLayout from "./BaseLayout.astro";
import Wordmark from "../components/Wordmark.astro";

const supportEmail = "mailto:support@spacemancodes.com";

type Props = {
  title: string;
  description: string;
  heading: string;
  summary: string;
  contactIntro: string;
  sections: Array<{
    title: string;
    body: string;
  }>;
};

const {
  title,
  description,
  heading,
  summary,
  contactIntro,
  sections,
} = Astro.props;

const isPrivacy = heading === "Privacy Policy";
const isTerms = heading === "Terms of Service";
const isSupport = heading === "Support";
---

<BaseLayout title={title} description={description} bodyClass="legal-body antialiased" themeColor="#b6ff51">
    <main id="main">
      <header class="legal-head">
        <a href="/" aria-label="Buff home">
          <Wordmark tone="acid" />
        </a>
        <nav class="legal-nav">
          <a href="/privacy" aria-current={isPrivacy ? "page" : undefined}>Privacy</a>
          <a href="/terms" aria-current={isTerms ? "page" : undefined}>Terms</a>
          <a href="/support" aria-current={isSupport ? "page" : undefined}>Support</a>
        </nav>
      </header>

      <article class="legal-article">
        <h1>{heading}</h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-ink-soft">
          {summary}
        </p>

        <div class="mt-12">
          {sections.map((section) => (
            <section class="legal-section">
              <h2>{section.title}</h2>
              <p class="mt-3 max-w-3xl text-lg leading-8 text-ink-soft">{section.body}</p>
            </section>
          ))}
        </div>

        <section class="legal-section mt-4">
          <h2>Contact</h2>
          <p class="mt-3 max-w-3xl text-lg leading-8 text-ink-soft">
            {contactIntro}
            <a class="font-semibold text-night underline decoration-2 underline-offset-4" href={supportEmail}>support@spacemancodes.com</a>.
          </p>
        </section>
      </article>
    </main>
</BaseLayout>
