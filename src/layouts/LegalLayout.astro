---
import "../styles/global.css";

type Props = {
  title: string;
  description: string;
  heading: string;
  summary: string;
  contactIntro: string;
  sections: Array<{
    title: string;
    body: string;
  }>;
};

const {
  title,
  description,
  heading,
  summary,
  contactIntro,
  sections,
} = Astro.props;

const isPrivacy = heading === "Privacy Policy";
const isTerms = heading === "Terms of Service";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      const applyTheme = () => {
        document.documentElement.classList.toggle("dark", window.matchMedia("(prefers-color-scheme: dark)").matches);
      };

      applyTheme();
      window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", applyTheme);
    </script>
  </head>
  <body class="bg-secondary text-stone-950 antialiased dark:text-stone-100">
    <main class="min-h-screen">
      <header class="border-b border-stone-950/10 px-5 py-5 dark:border-white/10 sm:px-8">
        <div class="mx-auto flex max-w-4xl items-center justify-between">
          <a href="/" class="flex items-center gap-3" aria-label="Buff home">
            <img src="/icon-dark.png" alt="" class="h-10 w-10 rounded-[13px]" />
            <span class="text-lg font-black text-primary">Buff</span>
          </a>
          <nav class="flex items-center gap-5 text-sm font-bold text-stone-700 dark:text-stone-300">
            <a
              href="/privacy"
              aria-current={isPrivacy ? "page" : undefined}
              class:list={[
                "transition hover:text-stone-950 dark:hover:text-white",
                isPrivacy && "text-stone-950 dark:text-white",
              ]}
            >
              Privacy
            </a>
            <a
              href="/terms"
              aria-current={isTerms ? "page" : undefined}
              class:list={[
                "transition hover:text-stone-950 dark:hover:text-white",
                isTerms && "text-stone-950 dark:text-white",
              ]}
            >
              Terms
            </a>
          </nav>
        </div>
      </header>

      <article class="mx-auto max-w-4xl px-5 py-14 sm:px-8 sm:py-20">
        <p class="text-sm font-black uppercase text-primary">Legal</p>
        <h1 class="mt-4 text-5xl leading-[0.98] sm:text-6xl">{heading}</h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-stone-700 dark:text-stone-300">
          {summary}
        </p>

        <div class="mt-12 divide-y divide-stone-950/12 border-y border-stone-950/12 dark:divide-white/12 dark:border-white/12">
          {sections.map((section) => (
            <section class="py-7">
              <h2 class="text-2xl">{section.title}</h2>
              <p class="mt-3 max-w-3xl text-lg leading-8 text-stone-700 dark:text-stone-300">{section.body}</p>
            </section>
          ))}
        </div>

        <section class="mt-12">
          <h2 class="text-2xl">Contact</h2>
          <p class="mt-3 max-w-3xl text-lg leading-8 text-stone-700 dark:text-stone-300">
            {contactIntro}
            <a class="font-bold text-stone-950 underline decoration-stone-950/30 underline-offset-4 dark:text-white dark:decoration-white/30" href="https://play.google.com/store/apps/details?id=com.mason.buff">Google Play listing</a>.
          </p>
        </section>
      </article>
    </main>
  </body>
</html>
