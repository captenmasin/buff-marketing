---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import StoreBadges from "../components/StoreBadges.astro";
import { heading, lede } from "../lib/site.ts";

const shots = [
  { src: "/screenshots/today.png", alt: "Buff Today with calorie ring, macros, and meals.", crop: "top" },
  { src: "/screenshots/meals.png", alt: "Buff food search with previous meals.", crop: "top" },
  { src: "/screenshots/add.png", alt: "Buff Add sheet with Search, Scan, Photo, Custom, Recipe, and Workout.", crop: "end" },
  { src: "/screenshots/weekly.png", alt: "Buff Weekly roundup with calorie average and macros.", crop: "top" },
];
---

<BaseLayout
  title="Buff. The simple calorie and workout log"
  description="Buff is a nutrition tracker for iOS and Android. Log meals with search, barcode scanning, or photo estimates. Track calories, macros, workouts, and progress."
  themeColor="#f5f6f6"
>
  <div class="wrap">
    <SiteHeader showStores />

    <main id="main">
      <section class="intro">
        <h1>{heading}</h1>
        <p>{lede}</p>
      </section>

      <section class="film" aria-label="Buff screens">
        <div class="film-row">
          {shots.map((shot) => (
            <figure class:list={["shot", shot.crop === "end" && "end"]}>
              <img src={shot.src} alt={shot.alt} width="780" height="1688" />
            </figure>
          ))}
        </div>
      </section>

      <section class="close">
        <StoreBadges />
      </section>
    </main>

    <SiteFooter />
  </div>
</BaseLayout>
