---
import BaseLayout from "../layouts/BaseLayout.astro";
import Wordmark from "../components/Wordmark.astro";
---

<BaseLayout
  title="Page not found. Buff"
  description="The page you were looking for could not be found on the Buff website."
  robots="noindex"
  themeColor="#f5f6f6"
>
  <main
    id="main"
    class="wrap"
    style="display: flex; min-height: 100svh; flex-direction: column; align-items: center; justify-content: center; text-align: center;"
  >
    <a href="/" aria-label="Buff home">
      <Wordmark />
    </a>
    <h1 style="margin-top: 2.5rem; font-size: clamp(1.85rem, 3.4vw, 2.65rem);">This page is not here.</h1>
    <a href="/" class="btn" style="margin-top: 1.15rem;">Back to Buff</a>
  </main>
</BaseLayout>
