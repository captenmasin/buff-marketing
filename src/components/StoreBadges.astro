---
import { appStore, play } from "../lib/site.ts";
---

<div class="stores">
  <a href={appStore} aria-label="Download Buff on the App Store">
    <img src="/app-store.svg" alt="Download on the App Store" class="store" width="120" height="40" />
  </a>
  <a href={play} aria-label="Get Buff on Google Play">
    <img src="/google-play.svg" alt="Get it on Google Play" class="store" width="180" height="54" />
  </a>
</div>
